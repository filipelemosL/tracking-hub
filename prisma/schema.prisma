generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrackingSession {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @unique @map("session_id") @db.VarChar(128)
  visitorId         String?  @map("visitor_id") @db.VarChar(128)
  pageUrl           String   @map("page_url") @db.Text
  customFields      Json     @map("custom_fields") @db.JsonB
  fbclid            String?  @db.VarChar(512)
  fbc               String?  @db.VarChar(512)
  fbp               String?  @db.VarChar(512)
  gclid             String?  @db.VarChar(512)
  gbraid            String?  @db.VarChar(512)
  wbraid            String?  @db.VarChar(512)
  ttclid            String?  @db.VarChar(512)
  ttp               String?  @db.VarChar(512)
  redtrackClickId   String?  @map("redtrack_click_id") @db.VarChar(512)
  utmifyId          String?  @map("utmify_id") @db.VarChar(512)
  customerEmailHash String?  @map("customer_email_hash") @db.Char(64)
  customerPhoneHash String?  @map("customer_phone_hash") @db.Char(64)
  capturedAt        DateTime? @map("captured_at") @db.Timestamptz(3)
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  orders            Order[]

  @@index([fbclid])
  @@index([fbc])
  @@index([gclid])
  @@index([gbraid])
  @@index([wbraid])
  @@index([ttclid])
  @@index([redtrackClickId])
  @@index([utmifyId])
  @@index([customerEmailHash, capturedAt])
  @@index([customerPhoneHash, capturedAt])
  @@map("tracking_sessions")
}

enum WebhookStatus {
  PENDING
  WAITING_TRACKING
  PROCESSED
  CONFLICT
  FAILED
}

enum AttributionStatus {
  ATTRIBUTED
  UNATTRIBUTED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  RETRY_PENDING
  DELIVERED
  FAILED_PERMANENT
  FAILED_EXHAUSTED
  UNKNOWN
  SKIPPED
}

enum AttemptStatus {
  STARTED
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  UNKNOWN
}

enum ConversionProvider {
  META
  GOOGLE
  TIKTOK
  UTMIFY
  REDTRACK
}

model WebhookEvent {
  id                String        @id @default(uuid()) @db.Uuid
  eventId           String        @unique @map("event_id") @db.VarChar(128)
  event             String        @db.VarChar(32)
  orderId           String        @map("order_id") @db.VarChar(128)
  originalPayload   Json          @map("original_payload") @db.JsonB
  normalizedPayload Json          @map("normalized_payload") @db.JsonB
  scenario          String        @default("SUCCESS") @db.VarChar(64)
  status            WebhookStatus @default(PENDING)
  reason            String?       @db.VarChar(64)
  receivedAt        DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  occurredAt        DateTime?     @map("occurred_at") @db.Timestamptz(3)
  trackingDeadline  DateTime?     @map("tracking_deadline") @db.Timestamptz(3)
  nextAttemptAt     DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  retryCount        Int           @default(0) @map("retry_count")
  lastError         String?       @map("last_error") @db.VarChar(128)
  orderDbId         String?       @map("order_db_id") @db.Uuid
  order             Order?        @relation(fields: [orderDbId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([orderId, receivedAt])
  @@map("webhook_events")
}

model Order {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @unique @map("order_id") @db.VarChar(128)
  amount            BigInt
  currency          String               @db.Char(3)
  occurredAt        DateTime             @map("occurred_at") @db.Timestamptz(3)
  timeSource        String               @map("time_source") @db.VarChar(16)
  attributionStatus AttributionStatus    @map("attribution_status")
  trackingSessionId String?              @map("tracking_session_id") @db.Uuid
  trackingSession   TrackingSession?     @relation(fields: [trackingSessionId], references: [id])
  attribution       Json                 @db.JsonB
  conversionContext Json?                @map("conversion_context") @db.JsonB
  webhookEvents     WebhookEvent[]
  deliveries        ConversionDelivery[]

  @@map("orders")
}

model ConversionDelivery {
  id           String             @id @default(uuid()) @db.Uuid
  orderDbId    String             @map("order_db_id") @db.Uuid
  order        Order              @relation(fields: [orderDbId], references: [id])
  type         String             @db.VarChar(32)
  provider     ConversionProvider
  conversionId String             @unique @map("conversion_id") @db.Char(64)
  status       DeliveryStatus     @default(PENDING)
  nextAttemptAt DateTime?         @map("next_attempt_at") @db.Timestamptz(3)
  reason       String?            @db.VarChar(64)
  scenario     String             @default("SUCCESS") @db.VarChar(64)
  transportMode String            @default("SIMULATED") @map("transport_mode") @db.VarChar(16)
  payloadSchemaVersion String     @default("demo-v1") @map("payload_schema_version") @db.VarChar(32)
  frozenRequest Json?             @map("frozen_request") @db.JsonB
  requestDigest String?           @map("request_digest") @db.Char(64)
  claimToken String?              @map("claim_token") @db.Uuid
  leaseUntil DateTime?            @map("lease_until") @db.Timestamptz(3)
  attempts ConversionAttempt[]

  @@unique([orderDbId, type, provider])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@map("conversion_deliveries")
}

model ConversionAttempt {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @map("delivery_id") @db.Uuid
  delivery ConversionDelivery @relation(fields: [deliveryId], references: [id])
  attemptNumber Int @map("attempt_number")
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  status AttemptStatus @default(STARTED)
  httpStatus Int? @map("http_status")
  errorCode String? @map("error_code") @db.VarChar(64)
  response Json? @db.JsonB
  request Json @db.JsonB
  requestDigest String @map("request_digest") @db.Char(64)

  @@unique([deliveryId, attemptNumber])
  @@map("conversion_attempts")
}
